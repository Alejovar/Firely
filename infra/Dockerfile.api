# Firely API: FastAPI + DuckDB reading Parquet from a read-only volume mounted at /data/processed.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY infra/requirements-api.txt ./requirements.txt
RUN pip install -r requirements.txt

# Only what the API imports at runtime (api -> pipeline.harmonize/analysis/nrt, ai.*).
COPY api ./api
COPY pipeline ./pipeline
COPY ai ./ai
# bot/client.py: Telegram client used by the daily alerts job (python -m pipeline.alerts_job).
COPY bot ./bot
COPY infra/scheduler.py ./infra/scheduler.py

# /state: writable app state (CAP drafts, NASA POWER/GFWED caches, subscriptions, alert log, NRT Parquet); compose mounts a named volume there.
RUN useradd --system --uid 10001 --no-create-home firely && mkdir -p /tmp/firely-interim /state && chown firely /tmp/firely-interim /state
USER firely

ENV FIRELY_API_MODE=real \
    FIRELY_DATA_PROCESSED=/data/processed \
    FIRELY_DATA_RAW=/data/raw \
    FIRELY_DATA_INTERIM=/tmp/firely-interim \
    FIRELY_STATE_DIR=/state

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/openapi.json', timeout=4).status == 200 else 1)"

# 2 workers fit a 4 GB instance (each query opens its own DuckDB connection capped at 1 GB).
CMD ["uvicorn", "api.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers", "--forwarded-allow-ips", "*"]
