# Local browser -> Vite -> API. These values contain no credentials.
VITE_API_URL=/api
# Direct FastAPI: http://127.0.0.1:8000 and FIRELY_API_PROXY_PATH=strip.
# EC2 SSH tunnel to nginx: http://127.0.0.1:18080 and preserve.
FIRELY_API_PROXY_TARGET=http://127.0.0.1:18080
FIRELY_API_PROXY_PATH=preserve
