# Copy to .env on the deployment host. Never commit real keys or tokens.
FIRELY_PORT=8080
FIRELY_DATA_PROCESSED=./data/processed
# Numeric group allowed to write the processed-data directory (id -g ubuntu on EC2).
FIRELY_DATA_GID=1000
FIRMS_MAP_KEY=
ANTHROPIC_API_KEY=
FIRELY_LLM_MODEL=
TELEGRAM_BOT_TOKEN=
# Public base URL for alert links, e.g. https://firely.example
FIRELY_PUBLIC_URL=
# Public API base URL for links generated by the bot, e.g. https://firely.example/api
FIRELY_PUBLIC_API_URL=
# Host allow-list for public MCP. Include localhost when testing locally.
FIRELY_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,54.80.16.144
FIRELY_MCP_ALLOWED_ORIGINS=

# Public domain behind Cloudflare (infra/README.md, "Dominio y HTTPS")
# FIRELY_HTTPS_PORT=443
# FIRELY_LETSENCRYPT_DIR=/etc/letsencrypt
